# Copy to `.env` and fill in. `.env` is gitignored.
#
# Only needed for the optional hosted run of Branch 3 (evaluation/run_pipeline.py
# with a hosted --vlm-model). The hosted runs used google/gemma-3-4b-it (deepinfra)
# and Qwen/Qwen2.5-VL-72B-Instruct (ovhcloud) through Hugging Face Inference
# Providers (https://router.huggingface.co/v1). Qwen2.5-VL-7B was not served there (checked July 2026).
# Hosted calls cost money. Local runs through LM Studio need no token.
# Create a token with "Make calls to Inference Providers" permission at
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
