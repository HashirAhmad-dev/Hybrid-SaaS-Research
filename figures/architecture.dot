// HybridSaaS-Sec architecture as evaluated and deployed (paper-v2). Editable source for Figure 1.
// Render: tools/render_figures.py (Graphviz dot -> PDF and SVG). Dashed = asynchronous path; dotted grey = not built.
// Layout (F8): top to bottom, one column per tier, every edge points down except the single decision return,
// edge labels sit on their own nodes' sides, so no edge crosses another and no label overlaps a box.
digraph hybridsaas {
  graph [rankdir=TB, fontname="Helvetica", fontsize=10, nodesep=0.35, ranksep=0.32, splines=ortho, pad=0.1,
         newrank=true];
  node  [shape=box, style="rounded", fontname="Helvetica", fontsize=9, margin="0.10,0.05", penwidth=0.8];
  edge  [fontname="Helvetica", fontsize=8, arrowsize=0.6, penwidth=0.8];

  client [label="SaaS client\n(API call + payload)"];
  proxy  [label="Inline proxy (FastAPI)\ntext and behaviour: Tier 1   |   image: Tier 2", style="rounded,bold"];

  subgraph cluster_t1 {
    label="Tier 1: inline, measured p99 45 ms"; labeljust=l; fontsize=9; style="rounded"; color="gray40";
    pii   [label="Text PII\nPresidio + 2 recognisers\n-> S (0-100)"];
    beh   [label="Behaviour vector\n6 features, 24 h window"];
    lstm  [label="LSTM encoder\nmemory bank -> a_LSTM"];
    ifor  [label="Isolation Forest\n-> a_IF"];
    drift [label="Per-user CUSUM\nslow-drift alarm"];
    fuse  [label="A = alpha a_LSTM + (1 - alpha) a_IF\n(alpha on validation)"];
    sbrs  [label="Gated risk fusion of S and A\nA >= tau_A: BLOCK; else bands\nPERMIT / ALERT / BLOCK", style="rounded,bold"];
  }
  subgraph cluster_t2 {
    label="Tier 2: asynchronous, upload held"; labeljust=r; fontsize=9; style="rounded,dashed"; color="gray40";
    ocr   [label="OCR (EasyOCR)\n-> Presidio"];
    route [label="OCR confidence\n< tau_ocr ?"];
    vlm   [label="Local VLM gemma-3-4b-it\n(VLM down: quarantine)"];
    s_img [label="S of the image"];
  }
  fl [label="Federated training\n(future work, not built)", style="rounded,dashed", fontcolor="gray40", color="gray50"];

  { rank=same; pii; beh; ocr; }
  { rank=same; lstm; ifor; drift; route; }

  client -> proxy;
  proxy -> pii;
  proxy -> beh;
  proxy -> ocr [style=dashed];
  beh -> lstm; beh -> ifor; beh -> drift;
  lstm -> fuse; ifor -> fuse;
  fuse -> sbrs;
  pii -> sbrs;
  drift -> sbrs:ne [style=dashed, taillabel="alarm", labeldistance=2.2];
  ocr -> route [style=dashed];
  route -> vlm [style=dashed, taillabel="yes", labeldistance=1.6];
  route -> s_img [style=dashed, taillabel="no", labeldistance=1.6];
  vlm -> s_img [style=dashed];
  s_img -> sbrs:e [style=dashed, constraint=false];
  sbrs -> proxy [constraint=false, headlabel="decision", labeldistance=3.5, labelangle=20];
  { rank=same; sbrs; s_img; }
}
